#!/bin/sh
# Keeps the package version in Cargo.toml and Cargo.lock at major.minor.<commit count>, the same number
# the release workflow and build.rs use, so `cargo build` prints the real version.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

base=$(git show :Cargo.toml 2>/dev/null | sed -n 's/^version = "\([0-9]*\.[0-9]*\)\..*/\1/p' | head -n 1)
[ -n "$base" ] || exit 0

if git rev-parse -q --verify HEAD >/dev/null; then
    if [ -f "$(git rev-parse --git-path MERGE_HEAD)" ]; then
        count=$(git rev-list --count HEAD MERGE_HEAD)
    else
        count=$(git rev-list --count HEAD)
    fi
    # An amend replaces HEAD instead of adding to it.
    case "$(ps -o args= -p "$PPID" 2>/dev/null)" in
        *--amend*) ;;
        *) count=$((count + 1)) ;;
    esac
else
    count=1
fi
version="$base.$count"

toml='0,/^version = .*/s//version = "'"$version"'"/'
lock='/^name = "rust-commander"$/{n;s/^version = .*/version = "'"$version"'"/;}'

# The index and the working tree are edited apart, so other unstaged edits in these files stay unstaged.
stage() {
    file=$1
    script=$2
    git ls-files --error-unmatch "$file" >/dev/null 2>&1 || return 0
    mode=$(git ls-files -s -- "$file" | cut -d' ' -f1)
    blob=$(git show ":$file" | sed "$script" | git hash-object -w --stdin)
    git update-index --cacheinfo "$mode,$blob,$file"
    if [ -f "$file" ]; then
        sed -i "$script" "$file"
    fi
}

stage Cargo.toml "$toml"
stage Cargo.lock "$lock"
