#!/bin/sh
# Cargo.toml holds the release version. The rust-commander entry in Cargo.lock follows that string.
set -e
cd "$(git rev-parse --show-toplevel)"

version=$(git show :Cargo.toml 2>/dev/null | sed -n 's/^version = "\([^"]*\)".*/\1/p' | head -n 1)
[ -n "$version" ] || exit 0
git ls-files --error-unmatch Cargo.lock >/dev/null 2>&1 || exit 0

lock='/^name = "rust-commander"$/{n;s/^version = .*/version = "'"$version"'"/;}'
mode=$(git ls-files -s -- Cargo.lock | cut -d' ' -f1)
blob=$(git show :Cargo.lock | sed "$lock" | git hash-object -w --stdin)
git update-index --cacheinfo "$mode,$blob,Cargo.lock"
if [ -f Cargo.lock ]; then
    sed -i "$lock" Cargo.lock
fi
