# Maintainer: Marcus Wallén <sysopt@protonmail.com>
# CI rewrites pkgver and sha256sums. The tarball is packed next to this file.
pkgname=rust-commander
pkgver=0.2.111
pkgrel=1
pkgdesc='Dual-pane file manager'
arch=('x86_64')
url='https://github.com/gr3p/rust-commander'
license=('MIT')
depends=('gtk4' 'vte4' 'hicolor-icon-theme')
makedepends=('cargo' 'pkgconf')
optdepends=(
	'p7zip: 7z archives'
	'rar: rar archives'
	'alsa-lib: play music'
	'opus: play Opus files'
	'pipewire-alsa: music through PipeWire'
)
options=('!lto' '!debug')
install=rust-commander.install
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
	cd "$pkgname-$pkgver"
	# No .git in the release tarball, so the package version wins over the dirname guess.
	export RC_PKG_VERSION=$pkgver
	export RUSTUP_TOOLCHAIN=stable
	cargo build --locked --release
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 "target/release/$pkgname" -t "$pkgdir/usr/bin/"
	install -Dm644 data/rust-commander.desktop \
		"$pkgdir/usr/share/applications/se.rustcommander.RustCommander.desktop"
	install -Dm644 img/rust-commander.png \
		"$pkgdir/usr/share/icons/hicolor/512x512/apps/$pkgname.png"
	install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}
